{
  "name": "taproot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable, shape-and-text project canvas for long-running work, with a REST API and MCP server for agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "backup": "node dist/server/cli.js backup",
    "restore": "node dist/server/cli.js restore",
    "create-user": "node dist/server/cli.js create-user",
    "update": "sh scripts/update.sh",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.59.0",
    "pele": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/j4ckxyz/taproot.git"
  },
  "homepage": "https://github.com/j4ckxyz/taproot"
}
