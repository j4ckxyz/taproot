# Copy to .env and adjust. Every setting is optional.

# Public URL people and agents use to reach this server (used in setup snippets).
# PUBLIC_URL=https://taproot.example.com

# Set to true when served over HTTPS (behind a reverse proxy) so cookies are Secure.
# SECURE_COOKIES=true

# Let anyone who can reach the server create an account. The first account is always the admin.
# ALLOW_SIGNUP=false

# Where the SQLite database and backups live.
# DATA_DIR=./data
# BACKUP_DIR=./data/backups

# Automatic backups: hours between snapshots (0 turns them off) and how many to keep.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Allow MCP clients that can only take a URL to use /mcp/t/<token>.
# MCP_ALLOW_TOKEN_IN_URL=true

# PORT=8787
# SESSION_DAYS=30
# APP_NAME=Taproot

# Check GitHub once a day for a newer release and show "Update available" to admins.
# Only the public releases API is contacted. Set to false to turn it off.
# UPDATE_CHECK=true
